# 클라이언트 API URL (모바일/웹 빌드용)
VITE_API_BASE_URL=https://ppamong.com

# AdMob — 앱(네이티브) + 관리자 수익 API
# [관리자 API] Replit Secrets — npm run check:admob 로 검증
# ADMOB_CLIENT_ID=xxxx.apps.googleusercontent.com
# ADMOB_CLIENT_SECRET=GOCSPX-xxxx
# ADMOB_PUBLISHER_ID=pub-xxxxxxxxxxxxxxxx
# ADMOB_REFRESH_TOKEN=1//xxxx
#
# [Android Manifest App ID] APK 빌드 전 — npm run admob:write-native
# ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxx~yyyyyyyy
# ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxx~yyyyyyyy
#
# [광고 단위 ID] 관리자 → 동영상 광고 수익 현황에서 선택 (서버 저장, 앱 재시작만 필요)
# 또는 빌드 시 VITE_* 로 override (선택)
# VITE_ADMOB_AD_ID_ANDROID=ca-app-pub-xxxxxxxx/yyyyyyyy
# VITE_ADMOB_AD_ID_IOS=ca-app-pub-xxxxxxxx/yyyyyyyy
# VITE_ADMOB_REWARDED_ID_ANDROID=ca-app-pub-xxxxxxxx/yyyyyyyy
# VITE_ADMOB_REWARDED_ID_IOS=ca-app-pub-xxxxxxxx/yyyyyyyy

# 서버
BASE_URL=https://ppamong.com
PORT=5000

# GitHub Actions APK 가져오기 (슈퍼바이저 → 앱 파일 등록/다운로드)
# Replit Secrets 등에 설정 — private repo: repo + actions:read, public repo: actions:read
# GITHUB_TOKEN=ghp_xxxx
# GITHUB_REPO_OWNER=hanbaedal
# GITHUB_REPO_NAME=bbamong
# GITHUB_WORKFLOW_FILE=build-apk.yml

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ppamong?retryWrites=true&w=majority
MONGODB_DB_NAME=ppamong

# 레거시 PostgreSQL (선택) — 빠던9 공유 DB → MongoDB 가져오기
# 방법 A (빠던9 Replit과 동일, 권장):
# PGHOST=ep-xxxx.aws.neon.tech
# PGPORT=5432
# PGUSER=neondb_owner
# PGPASSWORD=비밀번호
# PGDATABASE=ppadun9
# 방법 B: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# PG_DATABASE_NAME=ppadun9  # DATABASE_URL 경로 DB만 바꿀 때
# PG_MONGO_SYNC_ENABLED=true       # (미사용) 서버 자동 예약 제거됨 — 관리자 「받기」만
# PG_MONGO_SYNC_MODE=replace       # replace=테이블 비우고 재저장(백필) | merge=upsert(기본)
# PG_MONGO_SYNC_HOUR_KST=1         # 자동 동기화 시각(한국시간, 기본 01:00)
# PG_MONGO_SYNC_MINUTE_KST=0

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# 경기관리·실황 (다음 스포츠 + 네이버 문자중계, API-SPORTS 키 불필요)
# MATCH_MGMT_DAILY_SYNC_HOUR_KST=9
# MATCH_MGMT_DAILY_SYNC_MINUTE_KST=0
# MATCH_MGMT_SEASON_START_MM_DD=03-01
# MATCH_MGMT_SEASON_END_MM_DD=10-31
# MATCH_MGMT_SEASON_IMPORT_DELAY_MS=80
# 실시간 스코어 폴링 (서버가 다음 스포츠 → Match DB)
# LIVE_SCORE_SYNC_INTERVAL_MS=2500
# LIVE_SCORE_SYNC_START_BEFORE_MS=60000
# LIVE_SCORE_MAX_REGISTRATION_ORDER=5
# 선택: 시즌 연도 강제 (미설정 시 요청 날짜의 연도 사용)
# KBO_SEASON=2026
# 상대전적(h2h) 재조회 간격(ms) — 기본 24시간
# H2H_REFRESH_MS=86400000

# Redis (Replit 내장: HOST/PORT 생략 가능. Upstash 등 외부 사용 시)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SMS 인증 (SOLAPI) — 회원가입·비밀번호 찾기 필수
# Replit: Tools → Secrets (Deploy 탭에도 동일 키) → Redeploy
# 발신번호는 SOLAPI 콘솔에 등록·승인된 번호만 사용
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER_PHONE=01012345678
# SOLAPI 키가 있어도 회원가입 SMS 인증을 끄려면: PHONE_VERIFICATION_REQUIRED=false
# SOLAPI 없을 때는 문자 대신 회원가입 화면에 인증번호 표시(in_app)

# Cloudflare R2 (권장 — 쇼핑몰 상품 이미지 CDN)
# Replit Secrets에 5개 모두 설정 후 Redeploy. 상세: docs/PPAMONG_몰_이미지_R2.md
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ppamong-mall
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# 5개 모두 있을 때만 R2 사용. 없으면 아래 GCS/로컬로 fallback.

# Replit Object Storage (선택 — 영상·광고·R2 미설정 시 몰 상품 이미지 GCS)
# Replit Tools → Object Storage 버킷 생성 후 Secrets에 추가
# PRIVATE_OBJECT_DIR=/bucket-id/private
# PUBLIC_OBJECT_SEARCH_PATHS=/bucket-id/public
# 미설정 시 몰 상품 이미지는 서버 로컬(data/uploads)에 저장됩니다.

# OAuth (Kakao / Google / Apple)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
